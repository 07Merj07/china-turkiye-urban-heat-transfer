# Python / notebook caches
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.venv/
venv/
env/

# Secrets / local configuration
.env
.env.*
!.env.example
.cdsapirc
*credentials*.json
*secret*.json

# The full source dataset remains local; use the provided copy script.
data/raw/UHII_dataset/*
!data/raw/UHII_dataset/README.md
!data/raw/UHII_dataset/.gitkeep

# External feature outputs are regenerated; commit only the reviewed country mapping.
data/external_features/*.csv
!data/external_features/China_Turkiye_city_mapping.csv
data/external_features/*.nc
data/external_features/appeears_work/

# Generated Phase 2 outputs, temporary data, and backup copies
outputs/phase2_outputs/*
!outputs/phase2_outputs/README.md
!outputs/phase2_outputs/.gitkeep
outputs/previous_output_backups/

# Large downloads and archives
*.nc
*.zip
*.7z
*.tar
*.gz

# Included in the local all-in-one ZIP for safekeeping; do not commit historical or unverified local-only assets.
/archive/
/data/local_only/
